# Temporal connection used by the Worker and demo CLI.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=refund-demo
# Unset, each process reports <pid>@refund-demo, not <pid>@<hostname>.
# TEMPORAL_IDENTITY=

# Live model selection. Set AGENT_MODEL_PROVIDER when both providers are
# configured. ANTHROPIC_MODEL and OPENAI_MODEL must name models the respective
# account can access. The stage remains deterministic unless --real-model is
# passed.
AGENT_MODEL_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=

# Opt-in token log for live model calls; summarize with: uv run refund-demo usage
# LOG_MODEL_USAGE=1

# Required only for --real. Test mode keys are accepted. Live keys are rejected.
STRIPE_API_KEY=

# Set this on the Worker for the effect beat (worker restart around the refund).
EFFECT_RESTART_WINDOW_SECONDS=0

# Local process metadata and the dry-run Stripe ledger live here.
DEMO_STATE_DIR=.demo-state
